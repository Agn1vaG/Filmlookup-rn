{
  "expo": {
    "name": "Polaris",
    "slug": "polaris",
    "version": "1.0.0",
    "orientation": "portrait",

    "icon": "./assets/images/Icon.png",

    "scheme": "polaris",
    "userInterfaceStyle": "automatic",

    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.agniva007.filmlookup",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },

    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#000000",
        "foregroundImage": "./assets/images/Icon.png"
      },
      "package": "com.agniva007.filmlookup"
    },

    "web": {
      "output": "static",
      "favicon": "./assets/images/Icon.png"
    },

    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/Icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#000000"
        }
      ],
      "expo-font",
      "expo-web-browser",
      "expo-image",
      "expo-status-bar"
    ],

    "experiments": {
      "typedRoutes": true
    },

    "extra": {
      "router": {},
      "eas": {
        "projectId": "69ac21e2-d25b-43d6-9ebf-4e3da18e65d8"
      }
    },

    "owner": "agniva007s-team"
  }
}